# Database
DATABASE_URL=postgresql://user:password@localhost:5432/openluma

# Better Auth
BETTER_AUTH_SECRET=generate-a-random-secret-here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth (optional — remove if not using Google login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Resend (for email notifications)
RESEND_API_KEY=re_your_resend_api_key

# Uploadthing (for file uploads)
UPLOADTHING_TOKEN=your-uploadthing-token

# AI Provider
OPENAI_API_KEY=sk-your-openai-api-key

# Cron job security (generate with: openssl rand -hex 32)
CRON_SECRET=your-cron-secret-here

# SMTP (takes precedence over Resend when SMTP_HOST is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true   # defaults to true on port 465
EMAIL_FROM="OpenLuma <noreply@example.com>"

# Paid events: guests pay via these links and quote their reference
PAYPAL_ME_URL=https://paypal.me/yourname
REVOLUT_ME_URL=https://revolut.me/yourname

# OpenAI-compatible LLM gateway (replaces OpenAI when LLM_BASE_URL is set)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
# Used when the primary call fails before answering
LLM_FALLBACK_MODEL=auto
LLM_FALLBACK_BASE_URL=

# Comma-separated emails allowed to create events (unset = everyone)
HOST_EMAILS=hi@grait.io
